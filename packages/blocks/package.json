{
  "name": "@rokkit/blocks",
  "version": "1.3.8",
  "description": "Markdown block plugins for Rokkit (Plot, Table, Sparkline, Mermaid)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerrythomas/rokkit.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "cp ../../LICENSE . && bun run clean && bun run build && node ../../config/pack-repoint.mjs",
    "postpublish": "node ../../config/pack-repoint.mjs --restore && rm -f LICENSE",
    "clean": "rm -rf dist",
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "dist/**/*.d.ts", "README.md", "LICENSE"],
  "dependencies": {
    "dompurify": "^3.0.0"
  },
  "peerDependencies": {
    "@rokkit/chart": "workspace:*",
    "@rokkit/core": "workspace:*",
    "@rokkit/forms": "workspace:*",
    "@rokkit/ui": "workspace:*",
    "mermaid": ">=11.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rokkit/chart": "workspace:*",
    "@rokkit/core": "workspace:*",
    "@rokkit/forms": "workspace:*",
    "@rokkit/ui": "workspace:*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.53.5",
    "svelte-check": "^4.4.3",
    "typescript": "^5.9.3"
  }
}
